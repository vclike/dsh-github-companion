# npm 10/11 strict peer-revalidation enters an infinite CPU loop resolving
# this tree's @deepseek-ai/* cordis-style peer graph (observed 2026-08-28:
# 100% CPU, zero progress, both registries, local + hosted runners).
# legacy-peer-deps skips the peer reconciliation and installs straight from
# the lockfile in under a second. See commit history 2026-08-28.
legacy-peer-deps=true
